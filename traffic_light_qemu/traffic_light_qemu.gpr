--  GPRbuild project for the bare-metal arm-eabi (Cortex-A9) QEMU build.
--
--  Lives in its own Alire crate (traffic_light_qemu/) because it needs the
--  arm-eabi cross toolchain, which cannot coexist with the native compiler
--  in the root crate's dependency solution (every compiler provides the
--  abstract `gnat` crate, and Alire allows only one per solution). See the
--  root alire.toml.
--
--  Targets QEMU's `xilinx-zynq-a9` machine via the toolchain-bundled
--  `light-tasking-zynq7000` GNAT runtime (Ravenscar tasking). The runtime
--  supplies the Cortex-A9 / hard-float / VFPv3 compiler switches and its
--  own startup + linker script (ram.ld), so this project does not carry a
--  crt0 or link.ld of its own.
--
--  Sources live in the repo root's src/ tree (referenced via ../); build
--  artifacts land at the repo root (../obj, ../bin) so the requirements
--  harness finds bin/qemu_zynq7000/traffic_light unchanged.
--
--  Build:
--    cd traffic_light_qemu && alr build
--  Run:
--    qemu-system-arm -M xilinx-zynq-a9 -nographic \
--                    -serial tcp:127.0.0.1:5555,server,nowait \
--                    -serial tcp:127.0.0.1:5556,server,nowait \
--                    -kernel bin/qemu_zynq7000/traffic_light
--
--  See .claude/skills/qemu/SKILL.md and docs/requirements/wire-protocol.md.

project Traffic_Light_Qemu is

   --  Wall-clock microseconds budgeted for one logical 1 ms controller tick
   --  (see hal.adb). 1000 keeps faithful real time on clock-correct hardware
   --  or QEMU; lower values shorten each tick so the requirements suite runs
   --  faster (300 compensates upstream QEMU 8.2.2, whose Cortex-A9 private
   --  timer runs ~3.33x slow). Override per build:
   --    alr build -- -XTICK_PERIOD_US=300
   Tick_Period_Us := external ("TICK_PERIOD_US", "1000");

   for Languages   use ("Ada");
   for Source_Dirs use ("../src/core", "../src/app", "../src/hal/qemu_zynq7000");
   for Object_Dir  use "../obj/qemu_zynq7000";
   for Exec_Dir    use "../bin/qemu_zynq7000";
   for Main        use ("traffic_light.adb");

   for Target              use "arm-eabi";
   for Runtime ("Ada")     use "light-tasking-zynq7000";

   package Builder is
      for Default_Switches ("Ada") use ("-j0", "-g");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g",
         "-O0",
         "-gnatwa",     --  all warnings
         "-gnata",      --  enable assertions
         "-gnato",      --  overflow checking
         "-ffunction-sections",
         "-fdata-sections");

      --  hal.adb substitutes $Tick_Period_Us via GNAT integrated
      --  preprocessing; prep.data turns preprocessing on for that one unit and
      --  -gnateD injects the value from the Tick_Period_Us external above.
      for Switches ("hal.adb") use
        Compiler'Default_Switches ("Ada")
        & ("-gnatep=" & Traffic_Light_Qemu'Project_Dir & "prep.data",
           "-gnateDTick_Period_Us=" & Tick_Period_Us);
   end Compiler;

   package Linker is
      --  The runtime links in its own ram.ld (-T ram.ld via runtime.xml);
      --  pair gc-sections with the -ffunction/-fdata-sections above.
      for Switches ("Ada") use ("-Wl,--gc-sections");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end Traffic_Light_Qemu;
