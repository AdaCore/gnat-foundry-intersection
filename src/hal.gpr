with "../config/traffic_light_config.gpr";
with "shared.gpr";
with "types.gpr";

project Hal is

   --  Wall-clock microseconds budgeted for one logical 1 ms controller tick
   --  (see the Timings bodies). 1000 keeps faithful real time on clock-correct
   --  hardware or QEMU; lower values shorten each tick so the requirements
   --  suite runs faster (300 compensates upstream QEMU 8.2.2, whose Cortex-A9
   --  private timer runs ~3.33x slow). Each value selects a pre-defined profile
   --  spec (timings-tick_config__<value>.ads) via the Naming package below --
   --  no source preprocessing, so the sources stay valid Ada for ALS / GNAT
   --  Studio. Override per build:
   --    alr build -- -XTICK_PERIOD_US=300
   type Tick_Period_Us_Type is ("1000", "300", "10");
   Tick_Period_Us : Tick_Period_Us_Type := external ("TICK_PERIOD_US", "1000");

   --  Shared specs (Timings / Sources / Display + the Tick_Config profiles)
   --  live in hal/common so both profiles expose an IDENTICAL surface;
   --  only the bodies are profile-specific. Depends on types.gpr for the
   --  shared type vocabulary and the bus signatures the producers/consumers
   --  match.
   case Shared.Build is
      when "native" =>
         for Source_Dirs use ("hal/common", "hal/host");
      when "target" =>
         for Source_Dirs use ("hal/common", "hal/qemu_zynq7000");
   end case;

   package Naming is
      --  Map the TICK_PERIOD_US profile onto the Timings.Tick_Config spec on
      --  BOTH profiles -- the compile-time speed-up eases host testing and
      --  debugging too. The unselected timings-tick_config__*.ads files stay
      --  out of the build.
      for Specification ("Timings.Tick_Config")
      use "timings-tick_config__" & Tick_Period_Us & ".ads";
   end Naming;

   --  Default Alire layout: obj/<profile> (e.g. obj/development) and bin/.
   --  Both are two levels / one level below the root respectively, which the
   --  Gnattest Tests_Root below relies on. CI and docs reference these paths.
   for Object_Dir use Shared'Object_Dir;
   for Create_Missing_Dirs use "True";

   package Compiler renames Shared.Compiler;
   package Binder renames Shared.Binder;

end Hal;