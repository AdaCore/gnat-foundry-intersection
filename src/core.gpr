with "../config/traffic_light_config.gpr";
--  NOTE: this project should not import hal*.gpr. See design/architecture.md.
--  It depends on types.gpr only (core -> types): the core loop needs the
--  States vocabulary but must stay ignorant of the hardware.

with "shared.gpr";
with "types.gpr";

project Core is

   --  Core target-independent controller logic resides in `src/core`.
   for Source_Dirs use ("core");

   --  Default Alire layout: obj/<profile> (e.g. obj/development) and bin/.
   --  CI and docs reference these paths.
   for Object_Dir use Shared'Object_Dir;
   for Create_Missing_Dirs use "True";

   package Compiler renames Shared.Compiler;
   package Binder renames Shared.Binder;
   package Linker renames Shared.Linker;

end Core;