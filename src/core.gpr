with "../config/traffic_light_config.gpr";
--  NOTE: this project should not import hal*.gpr. See docs/architecture/overview.md.

project Core is

   --  Core target-independent controller logic resides in `src/core`.
   for Source_Dirs use ("core");

   --  Default Alire layout: obj/<profile> (e.g. obj/development) and bin/.
   --  Both are two levels / one level below the root respectively, which the
   --  Gnattest Tests_Root below relies on. CI and docs reference these paths.
   for Object_Dir use "obj/" & Traffic_Light_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   -- Light-tasking runtimes do not support stack overflow checking, so we pass
   -- `-fstack-check` based on an external which the target build will set to
   -- "disabled".
   type Stack_Check_Kind is ("enabled", "disabled");
   Stack_Check : Stack_Check_Kind := external ("STACK_CHECK", "enabled");

   Stack_Check_Switches := ();
   case Stack_Check is
      when "disabled" => Stack_Check_Switches := ();
      when "enabled"  => Stack_Check_Switches := ("-fstack-check");
   end case;

   package Compiler is
      --  Common switches come from the Alire config (driven by alire.toml's
      --  [build-switches]). Append the safety switches the default profile
      --  omits: -gnata (assertions/contracts), -gnato (overflow checks),
      --  -fstack-check (if enabled).
      for Default_Switches ("Ada") use
        Traffic_Light_Config.Ada_Compiler_Switches &
      ("-gnata", "-gnato") & Stack_Check_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Core;