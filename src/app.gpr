with "../config/traffic_light_config.gpr";
--  The application layer -- the integration point that owns the entry point
--  (src/app/main.adb) and wires the buses to the HAL to run the core loop
--  (design/architecture.md §"Project structure" / §"The core loop"). It
--  depends on the full closure it assembles -- core (the loop), hal (the
--  producers/consumer + timing), and types (the bus and state vocabulary) --
--  but is NOT a proof target: main.adb carries no SPARK_Mode, so gnatprove
--  skips it.
--
--  Like core/hal/types this is a pure source project (no Main / Exec_Dir): the
--  crate-root wrapper ../traffic_light.gpr *extends* it (host build) and the
--  QEMU crate ../traffic_light_qemu/traffic_light_qemu.gpr `with`s it
--  (arm-eabi), and those own the `Main` / Exec_Dir. Extension makes main.adb a
--  source of the crate root, so the executable lands at the repo-root bin/
--  those wrappers expect -- keeping the `traffic_light` binary name and the
--  Makefile / Alire / coverage targets unchanged.

with "shared.gpr";
with "core.gpr";
with "hal.gpr";
with "types.gpr";

project App is

   --  The application entry point (main.adb) resides in `src/app`.
   for Source_Dirs use ("app");

   --  Share the common object dir with the rest of the src/ closure.
   for Object_Dir use Shared'Object_Dir;
   for Create_Missing_Dirs use "True";

   package Compiler renames Shared.Compiler;
   package Binder renames Shared.Binder;
   package Linker renames Shared.Linker;

end App;
