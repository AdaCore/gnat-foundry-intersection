with "../config/traffic_light_config.gpr";

project Hal_Target is

   for Languages   use ("Ada", "ASM_CPP");

   --  Wall-clock microseconds budgeted for one logical 1 ms controller tick
   --  (see hal.adb). 1000 keeps faithful real time on clock-correct hardware
   --  or QEMU; lower values shorten each tick so the requirements suite runs
   --  faster (300 compensates upstream QEMU 8.2.2, whose Cortex-A9 private
   --  timer runs ~3.33x slow). Each value selects a pre-defined profile spec
   --  (hal-tick_config__<value>.ads) via the Naming package below -- no source
   --  preprocessing, so the sources stay valid Ada for ALS / GNAT Studio.
   --  Override per build:
   --    alr build -- -XTICK_PERIOD_US=300
   type Tick_Period_Us_Type is ("1000", "300", "10");
   Tick_Period_Us : Tick_Period_Us_Type := external ("TICK_PERIOD_US", "1000");

   --  Structured src/: the cross build selects ONLY src/hal/qemu_zynq7000.
   --  src/hal/host belongs to the host build and must NOT be compiled
   --  here -- hence an explicit dir list rather than "src/**".
   for Source_Dirs use ("hal/qemu_zynq7000");

   --  Default Alire layout: obj/<profile> (e.g. obj/development) and bin/.
   --  Both are two levels / one level below the root respectively, which the
   --  Gnattest Tests_Root below relies on. CI and docs reference these paths.
   for Object_Dir use "obj/" & Traffic_Light_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  Common switches come from the Alire config (driven by alire.toml's
      --  [build-switches]). Append the safety switches the default profile
      --  omits: -gnata (assertions/contracts), -gnato (overflow checks).
      for Default_Switches ("Ada") use
        Traffic_Light_Config.Ada_Compiler_Switches &
      ("-gnata", "-gnato");
   end Compiler;

   package Naming is
      --  Map the TICK_PERIOD_US profile onto the HAL.Tick_Config spec. The
      --  unselected hal-tick_config__*.ads files stay out of the build.
      for Specification ("HAL.Tick_Config")
      use "hal-tick_config__" & Tick_Period_Us & ".ads";
   end Naming;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Hal_Target;