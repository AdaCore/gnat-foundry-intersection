with "../config/traffic_light_config.gpr";

--  A shared project, containing definitions that are reused accross projects.

project Shared is

   for Source_Dirs use ();

   --  The build kind
   type Build_Kind is ("native", "target");
   Build : Build_Kind := external ("BUILD_KIND", "native");

   --  Light-tasking runtimes do not support stack overflow checking, so we
   --  pass `-fstack-check` based on an external which the target build will
   --  set to "disabled".
   type Stack_Check_Kind is ("enabled", "disabled");
   Stack_Check : Stack_Check_Kind := external ("STACK_CHECK", "enabled");

   --  The compiler switches to use for Ada.
   Ada_Compiler_Switches := Traffic_Light_Config.Ada_Compiler_Switches &
      ("-g", "-O0",      --  Debug, no optimization
       "-gnata",         --  Enable assertions
       "-gnato",         --  overflow checking
       "-fstack-check",
       "-gnatW8"         --  UTF-8 encoding for sources
      );

   Stack_Check_Switches := ();
   case Stack_Check is
      when "disabled" => null;
      when "enabled"  => Stack_Check_Switches := ("-fstack-check");
   end case;

   case Build is
      when "native" =>
         Ada_Compiler_Switches := Ada_Compiler_Switches & Stack_Check_Switches;
      when "target" =>
         Ada_Compiler_Switches := Ada_Compiler_Switches &
         ("-ffunction-sections", "-fdata-sections") & Stack_Check_Switches;
         for Target          use "arm-eabi";
         for Runtime ("Ada") use "light-tasking-zynq7000";
   end case;

   package Compiler is
      for Default_Switches ("Ada") use Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      case Build is
         when "native" => null; --  default host build (stub HAL)
         when "target" =>
            --  The runtime links in its own ram.ld (-T ram.ld via runtime.xml);
            --  pair gc-sections with the -ffunction/-fdata-sections above.
            for Switches ("Ada") use ("-Wl,--gc-sections");
      end case;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Shared;