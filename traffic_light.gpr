--  Top-level project for the traffic-light controller (host build).
--
--  Builds the host executable using src/hal/host as the stub HAL. The
--  bare-metal arm-eabi cross-target build (QEMU xilinx-zynq-a9) lives in
--  its own Alire crate, traffic_light_qemu/ (see that crate's GPR).

with "config/traffic_light_config.gpr";
with "src/core.gpr";
with "src/hal.gpr";
with "src/shared.gpr";

project Traffic_Light is

   --  Structured src/: the host build selects ONLY src/hal/host (the stub
   --  HAL). src/hal/qemu_zynq7000 belongs to the arm-eabi cross build and
   --  must NOT be compiled here -- hence an explicit dir list rather than
   --  "src/**". config/ holds the Alire-generated config package.
   for Source_Dirs use ("src/app", "config/");

   --  Default Alire layout: obj/<profile> (e.g. obj/development) and bin/.
   --  Both are two levels / one level below the root respectively, which the
   --  Gnattest Tests_Root below relies on. CI and docs reference these paths.
   for Object_Dir use "obj/" & Traffic_Light_Config.Build_Profile;
   for Exec_Dir   use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("traffic_light.adb");

   for Runtime ("Ada") use Shared'Runtime ("Ada");
   for Target use Shared'Target;

   package Compiler renames Shared.Compiler;
   package Binder renames Shared.Binder;
   package Linker renames Shared.Linker;

   package Format is
      for Ignore use ".gnatformat_ignore.txt";
   end Format;

end Traffic_Light;
