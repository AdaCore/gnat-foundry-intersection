--  Crate-root project for the traffic-light controller (host build).
--
--  The substantive application project is now src/app.gpr (per
--  design/architecture.md §"Project structure"). This project *extends* it so
--  the application sources -- notably the entry point main.adb -- belong to
--  the crate root: that keeps this the Alire crate root (alire.toml
--  project-files) and the GNATtest driver root, and lets the executable land
--  at the repo-root bin/ with the pinned `traffic_light` name. The bare-metal
--  arm-eabi cross-target build (QEMU xilinx-zynq-a9) lives in its own Alire
--  crate, traffic_light_qemu/ (see that crate's GPR).

with "config/traffic_light_config.gpr";
with "src/shared.gpr";

project Traffic_Light extends "src/app.gpr" is

   --  Source dirs are inherited from the extended src/app.gpr (i.e. src/app),
   --  so the application sources -- notably main.adb -- belong to this crate
   --  root. (Do NOT override with an empty list: a source-less extending
   --  project trips gnattest's source discovery.)

   --  Default Alire layout: obj/<profile> (e.g. obj/development) and bin/.
   --  Both are two levels / one level below the root respectively, which the
   --  Gnattest Tests_Root below relies on. CI and docs reference these paths.
   for Object_Dir use Shared'Object_Dir;
   for Exec_Dir use Shared'Exec_Dir;
   for Create_Missing_Dirs use "True";

   --  main.adb is inherited from the extended src/app.gpr.
   for Main use ("main.adb");

   for Runtime ("Ada") use Shared'Runtime ("Ada");
   for Target use Shared'Target;

   --  Keep the produced binary named `traffic_light` regardless of the unit
   --  name, so the Makefile run targets and coverage need no edits.
   package Builder is
      for Executable ("main.adb") use "traffic_light";
   end Builder;

   package Compiler renames Shared.Compiler;
   package Binder renames Shared.Binder;
   package Linker renames Shared.Linker;

   package Format is
      for Ignore use ".gnatformat_ignore.txt";
   end Format;

   --  GNATtest configuration. Skeleton bodies land under <root>/tests/
   --  (Object_Dir = obj/<profile> -> two levels up); unimplemented skeletons
   --  pass by default so the alire-testing harness stays green until the
   --  cmd_input / diagnostic / hal stubs are fleshed out. Re-run with
   --  `PATH="$HOME/.alire/bin:$PATH" alr exec -- gnattest -P traffic_light.gpr`
   --  to regenerate skeletons after a src/ surface change.
   package Gnattest is
      for Tests_Root        use "../../tests";
      for Skeletons_Default use "pass";
   end Gnattest;

end Traffic_Light;
