--  Top-level project for the traffic-light controller (host build).
--
--  Builds the host executable using src/hal/host as the stub HAL. The
--  cross-target build for STM32H563ZI is driven by Zephyr's CMake/west
--  via the project Makefile and traffic_light_zephyr.gpr (see ADR-0004).

project Traffic_Light is

   for Source_Dirs use ("src/core", "src/app", "src/hal/host");

   for Object_Dir use "obj/host";
   for Exec_Dir   use "bin/host";
   for Main use ("main.adb");

   package Builder is
      for Default_Switches ("Ada") use ("-j0", "-g");
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g",
         "-O0",
         "-gnatwa",     -- all warnings
         "-gnatVa",     -- all validity checks
         "-gnata",      -- enable assertions
         "-gnato",      -- overflow checking
         "-fstack-check");
   end Compiler;

   package Binder is
      for Default_Switches ("Ada") use ("-Es");
   end Binder;

   --  GNATtest configuration. Skeleton bodies land under <root>/tests/
   --  (Object_Dir = obj/host -> two levels up); unimplemented skeletons
   --  pass by default so the alire-testing harness stays green until the
   --  cmd_input / diagnostic / hal stubs are fleshed out. Re-run with
   --  `PATH="$HOME/.alire/bin:$PATH" alr exec -- gnattest -P traffic_light.gpr`
   --  to regenerate skeletons after a src/ surface change.
   package Gnattest is
      for Tests_Root        use "../../tests";
      for Skeletons_Default use "pass";
   end Gnattest;

end Traffic_Light;
