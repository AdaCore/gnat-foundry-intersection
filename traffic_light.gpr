--  Crate-root project for the traffic-light controller (host build), and the
--  application layer: it owns src/app -- notably the entry point main.adb,
--  which wires the buses to the HAL and runs the core loop
--  (design/architecture.md §"Project structure"). Owning those sources
--  directly is what lets `for Main` name main.adb here, so the executable
--  lands in this project's bin/ as `traffic_light`. NOT a proof target: it is
--  outside the proof scope (src/proof.gpr) altogether, and main.adb carries no
--  SPARK_Mode in any case. The bare-metal arm-eabi build lives in its own
--  Alire crate, traffic_light_qemu/.

with "config/traffic_light_config.gpr";
with "src/shared.gpr";
with "src/core.gpr";
with "src/hal.gpr";
with "src/types.gpr";

project Traffic_Light is

   for Source_Dirs use ("src/app");

   --  Default Alire layout
   for Object_Dir use Shared.Objdir_From_Root;
   for Exec_Dir use Shared.Execdir_From_Root;
   for Create_Missing_Dirs use "True";

   for Main use ("main.adb");

   for Runtime ("Ada") use Shared'Runtime ("Ada");
   for Target use Shared'Target;

   --  Keep the produced binary named `traffic_light` regardless of the unit
   --  name, so the Makefile run targets and coverage need no edits.
   package Builder is
      for Executable ("main.adb") use "traffic_light";
   end Builder;

   package Compiler renames Shared.Compiler;
   package Binder renames Shared.Binder;
   package Linker renames Shared.Linker;

   package Format is
      for Ignore use ".gnatformat_ignore.txt";
   end Format;

   --  GNATtest configuration.
   package Gnattest is
      for Tests_Root        use Project'Project_Dir & "tests";
      for Skeletons_Default use "fail";
   end Gnattest;

end Traffic_Light;
