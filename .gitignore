/install/
/pro-downloads/

# GNATtest — regenerated test specs (the .adb bodies are yours, do not gitignore)
tests/**/*-test_data.ads
tests/**/*-test_data-tests.ads

# GNATtest default scratch tree. Under the four-project graph the per-module
# sub-projects (types/core/hal) carry no Gnattest.Tests_Root, so `gnattest -U`
# emits their skeletons under src/tests/ rather than the canonical tests/ crate
# (Tests_Root => ../../tests). These are wholly regenerated by
# `make generate-tests`; hand-authored tests belong in the tests/ crate.
src/tests/

