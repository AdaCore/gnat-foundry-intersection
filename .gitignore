# GNATtest — regenerated test specs (the .adb bodies are yours, do not gitignore)
tests/**/*-test_data.ads
tests/**/*-test_data-tests.ads

# GNATtest tree for the per-module sub-projects (types/core/hal): they carry
# no Gnattest.Tests_Root, so `gnattest` emits their skeletons under src/tests/
# rather than the canonical tests/ crate (Tests_Root => ../../tests). Only the
# *.ads specs are wholly regenerated by `make generate-tests`; the .adb bodies
# hold the hand-written tests (preserved across regeneration) and are tracked.
src/tests/**/*-test_data.ads
src/tests/**/*-test_data-tests.ads

