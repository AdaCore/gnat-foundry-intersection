--  GPRbuild project for the Zephyr static-library build.
--
--  Compiles the Ada/SPARK sources into libada_app.a; Zephyr's CMake build
--  (see CMakeLists.txt) links that archive into the final firmware image.
--
--  Build via the project Makefile (`make`) which wraps `west build` with
--  `alr exec` so PATH points at the Alire-managed gnat_arm_elf toolchain.
--  See docs/architecture/overview.md and the alire skill's zephyr.md.

project Traffic_Light_Zephyr is

   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-cortex-m33f";

   for Source_Dirs use
     ("src/core",
      "src/app",
      "src/hal/zephyr");

   Ada_Obj_Dir := external ("ADA_OBJ_DIR", "build/ada_obj");
   for Object_Dir   use Ada_Obj_Dir;
   for Library_Dir  use Ada_Obj_Dir & "/lib";
   for Library_Name use "ada_app";
   for Library_Kind use "static";

   package Builder is
      for Default_Switches ("Ada") use ("-j0", "-g");
   end Builder;

   package Compiler is
      --  -mcpu / -mthumb / -mfpu / -mfloat-abi MUST match the binder
      --  invocation in CMakeLists.txt and CONFIG_FPU=y in prj.conf.
      for Default_Switches ("Ada") use
        ("-mcpu=cortex-m33", "-mthumb",
         "-mfpu=fpv5-sp-d16", "-mfloat-abi=hard",
         "-g",
         "-O0",
         "-gnatwa",     -- all warnings
         "-gnata",      -- enable assertions
         "-gnato",      -- overflow checking
         "-ffunction-sections",
         "-fdata-sections");
   end Compiler;

end Traffic_Light_Zephyr;
