{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote -v:*)",
      "Bash(alr build:*)",
      "Bash(alr exec --:*)",
      "Bash(alr show:*)",
      "Bash(alr version:*)",
      "Bash(gprbuild -P:*)",
      "Bash(gnatprove -P:*)",
      "Bash(gnatcheck -P:*)",
      "Bash(python3 tools/trace-check.py:*)",
      "Bash(python3 tools/render-srs.py:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)"
    ]
  },
  "hooks": {
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -e '[.tool_calls[]? | select((.tool_name | test(\"^(Write|Edit|MultiEdit)$\")) and ((.tool_input.file_path // \"\") | test(\"\\\\.(ads|adb)$\")))] | length > 0' >/dev/null && make -C \"$CLAUDE_PROJECT_DIR\" format-ada >&2 || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "adacore@adacore-skills": true
  },
  "extraKnownMarketplaces": {
    "adacore-skills": {
      "source": {
        "source": "github",
        "repo": "adacore/skills"
      },
      "autoUpdate": true
    }
  }
}
