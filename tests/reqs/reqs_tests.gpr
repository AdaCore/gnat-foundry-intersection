--  Requirements-based tests (#51).
--
--  Hand-written AUnit fixtures, one package per LLR file, one test routine
--  per LLR statement. Folded into the generated AUnit harness via
--  `gnattest --additional-tests=` (see the Makefile's `generate-tests`), so
--  these run in the same `make test` and are instrumented by the same
--  `make all-coverage` as the generated skeletons under tests/core, tests/types
--  and tests/hal.
--
--  Unlike those skeletons, nothing here is generated: the file layout mirrors
--  requirements/llr/, not the code's package structure, and each routine names
--  the statement it verifies in both its identifier and its `--@covers` tag.

with "aunit";
with "../../traffic_light.gpr";
with "../../src/shared.gpr";

project Reqs_Tests is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Languages use ("Ada");

   --  The same switches as every other project in the tree, for the same
   --  reasons -- but `-gnata` in particular, without which the contracts on
   --  Reqs_Support.Loop_Spy are dead text. Run's precondition is the whole
   --  reason its trace is a bounded array, and the spy degrades a violation
   --  into a silently truncated trace rather than a diagnosis, so the check has
   --  to be live. The warning and style switches come along, which is the only
   --  automated static gate this code has: `make format` and `make check` do
   --  not reach test sources (#108).
   --
   --  `-gnaty-c` is the one deliberate subtraction. The comment-format check
   --  requires two spaces after `--`, and the traceability tag does not have
   --  them: `--@covers <llr>.<n>` is the spelling `requirements/trace_chain.yaml`
   --  and the generated skeletons both use, so every one of the 98 tags here
   --  would report a style violation for obeying the convention. Nothing else
   --  in the check set is relaxed.
   package Compiler is
      for Default_Switches ("Ada") use
        Shared.Ada_Compiler_Switches & ("-gnaty-c");
   end Compiler;

end Reqs_Tests;
