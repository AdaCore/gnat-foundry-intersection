--  SPARK proof configuration for the conflict-check module.
--
--  Run with:
--    alr exec -- gnatprove -P tests/proof/conflict_check_proof.gpr --level=2

with "../../traffic_light.gpr";

project Conflict_Check_Proof is

   for Source_Dirs use ("../../src/core");
   for Object_Dir  use "obj";

   package Compiler renames Traffic_Light.Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2",
                                      "--report=statistics",
                                      "--checks-as-errors=on");
   end Prove;

end Conflict_Check_Proof;
