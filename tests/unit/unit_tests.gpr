--  Unit-test build configuration. Host-only.

with "../../traffic_light.gpr";

project Unit_Tests is

   for Source_Dirs use ("./");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("test_runner.adb");

   package Compiler renames Traffic_Light.Compiler;
   package Builder  renames Traffic_Light.Builder;

end Unit_Tests;
