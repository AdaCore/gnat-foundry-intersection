--  Nested test crate. The actual test executable is the AUnit harness
--  generated by gnattest under <parent>/obj/<profile>/gnattest/harness/.
--  This GPR exists so the Alire crate has a valid project-files entry
--  and so `alr exec` can supply aunit + the parent crate on
--  GPR_PROJECT_PATH when invoking gnattest / gprbuild on the harness.

project Tests is
   for Source_Dirs use ();
   for Object_Dir use "obj";
end Tests;
